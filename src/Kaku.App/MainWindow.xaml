<Window x:Class="Kaku.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Kaku.App.Localization"
        xmlns:vm="clr-namespace:Kaku.App.ViewModels"
        xmlns:views="clr-namespace:Kaku.App.Views"
        Title="Kaku" Width="1400" Height="860" AllowDrop="True"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI" FontSize="12.5">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Chevron" TargetType="ToggleButton">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent">
                            <TextBlock x:Name="G" Text="▸" Foreground="{DynamicResource Muted}" FontSize="12"
                                       HorizontalAlignment="Center" Margin="0,1,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="G" Property="Text" Value="▾"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ChapterTemplate" DataType="{x:Type vm:ChapterItem}">
            <Grid Margin="{Binding Indent, Converter={x:Static views:Converters.LeftMargin}}" ToolTip="{Binding ToolTipText}" ToolTipService.InitialShowDelay="900">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ToggleButton Style="{StaticResource Chevron}" IsChecked="{Binding IsExpanded}" Margin="0,3,0,0"
                              ToolTip="{l:T Chapter_ExpandTip}"
                              Visibility="{Binding CanExpand, Converter={StaticResource BoolVis}}"/>
                <Image Grid.Column="1" Source="{Binding Thumbnail}" Height="44" MaxWidth="34" Margin="0,0,6,0"
                       VerticalAlignment="Top" Visibility="{Binding HasThumbnail, Converter={StaticResource BoolVis}}"/>
                <StackPanel Grid.Column="2" Margin="0,3,2,4">
                    <DockPanel>
                        <TextBlock Text="{Binding NumberText}" Foreground="{DynamicResource Muted}" Margin="0,0,5,0" MinWidth="16"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding PositionText}" Foreground="{DynamicResource Muted}"
                                   FontSize="11" Margin="6,1,0,0"/>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Snippet}" Foreground="{DynamicResource Muted}" FontStyle="Italic" FontSize="11.5"
                               TextTrimming="CharacterEllipsis" Margin="21,1,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="21,2,0,0">
                        <TextBlock Text="{Binding ChildCountText}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,8,0"
                                   Visibility="{Binding ShowChildCount, Converter={StaticResource BoolVis}}"/>
                        <TextBlock Text="{Binding BookmarksText}" Foreground="{DynamicResource Accent}" FontSize="11" Margin="0,0,8,0"
                                   ToolTip="{l:T Chapter_BookmarksTip}" Visibility="{Binding HasBookmarks, Converter={StaticResource BoolVis}}"/>
                        <TextBlock Text="{Binding NotesText}" Foreground="{DynamicResource Link}" FontSize="11" Margin="0,0,8,0"
                                   ToolTip="{l:T Chapter_NotesTip}" Visibility="{Binding HasNotes, Converter={StaticResource BoolVis}}"/>
                        <TextBlock Text="✎" Foreground="{DynamicResource Modified}" FontSize="11" Margin="0,0,8,0" ToolTip="{l:T Chapter_ModifiedTip}"
                                   Visibility="{Binding IsModified, Converter={StaticResource BoolVis}}"/>
                        <TextBlock Text="⚠" Foreground="{DynamicResource Warning}" FontSize="11" Margin="0,0,8,0" ToolTip="{Binding ErrorText}"
                                   Visibility="{Binding HasError, Converter={StaticResource BoolVis}}"/>
                        <TextBlock Text="{l:T Chapter_NonLinear}" Foreground="{DynamicResource Muted}" FontSize="11"
                                   Visibility="{Binding IsNonLinear, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                    <ProgressBar Height="3" Margin="21,3,0,0" Maximum="100" Value="{Binding CursorPercent}"
                                 Foreground="#FFF0AA1E" Background="{DynamicResource ProgressTrack}" BorderThickness="0"
                                 Visibility="{Binding IsCurrent, Converter={StaticResource BoolVis}}"/>
                    <ItemsControl ItemsSource="{Binding Headings}" Margin="14,3,0,0"
                                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:HeadingItem}">
                                <Button Style="{StaticResource LinkButton}" Padding="0,1" Click="OnHeadingClick" Tag="{Binding}">
                                    <TextBlock Text="{Binding Title}" Margin="{Binding Indent, Converter={x:Static views:Converters.LeftMargin}}"
                                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSoft}"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="{DynamicResource PanelBg}" Padding="2">
            <MenuItem Header="{l:T Menu_File}">
                <MenuItem Header="{l:T Menu_Open}" InputGestureText="Ctrl+O" Click="OnOpenClick"/>
                <MenuItem x:Name="RecentMenu" Header="{l:T Menu_Recent}"/>
                <Separator/>
                <MenuItem x:Name="SaveMenu" Header="{l:T Menu_Save}" InputGestureText="Ctrl+S" Click="OnSaveClick" IsEnabled="False"/>
                <MenuItem x:Name="SaveAsMenu" Header="{l:T Menu_SaveAs}" InputGestureText="Ctrl+Mayús+S" Click="OnSaveAsClick" IsEnabled="False"/>
                <MenuItem Header="{l:T Menu_OpenBackups}" Click="OnOpenBackupsClick"/>
                <Separator/>
                <MenuItem x:Name="CloseBookMenu" Header="{l:T Menu_CloseBook}" Click="OnCloseBookClick" IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="{l:T Menu_Exit}" InputGestureText="Alt+F4" Click="OnExitClick"/>
            </MenuItem>
            <MenuItem Header="{l:T Menu_Edit}">
                <MenuItem Header="{l:T Menu_Undo}" InputGestureText="Ctrl+Z" Click="OnUndoClick"/>
                <MenuItem Header="{l:T Menu_Redo}" InputGestureText="Ctrl+Y" Click="OnRedoClick"/>
                <Separator/>
                <MenuItem Header="{l:T Menu_Cut}" Command="ApplicationCommands.Cut" InputGestureText="Ctrl+X"/>
                <MenuItem Header="{l:T Menu_Copy}" Command="ApplicationCommands.Copy" InputGestureText="Ctrl+C"/>
                <MenuItem Header="{l:T Menu_Paste}" Command="ApplicationCommands.Paste" InputGestureText="Ctrl+V"/>
                <Separator/>
                <MenuItem Header="{l:T Menu_Bold}" InputGestureText="Ctrl+B" Click="OnBoldClick"/>
                <MenuItem Header="{l:T Menu_Italic}" InputGestureText="Ctrl+I" Click="OnItalicClick"/>
                <Separator/>
                <MenuItem Header="{l:T Menu_InsertImage}" InputGestureText="Ctrl+Alt+I" Click="OnInsertImageClick"/>
                <MenuItem Header="{l:T Menu_InsertNote}" InputGestureText="Ctrl+Alt+N" Click="OnInsertNoteClick"/>
                <Separator/>
                <MenuItem x:Name="SpellCheckMenu" Header="{l:T Menu_SpellCheck}" IsCheckable="True" Click="OnSpellCheckMenuClick"/>
                <MenuItem Header="{l:T Menu_UserDictionary}" Click="OnUserDictionaryClick"/>
            </MenuItem>
            <MenuItem Header="{l:T Menu_Search}">
                <MenuItem Header="{l:T Menu_FindChapter}" InputGestureText="Ctrl+F" Click="OnFindChapterClick"/>
                <MenuItem Header="{l:T Menu_FindBook}" InputGestureText="Ctrl+Mayús+F" Click="OnFindBookClick"/>
                <MenuItem Header="{l:T Menu_ReplaceMenu}" InputGestureText="Ctrl+H" Click="OnReplaceMenuClick"/>
                <MenuItem Header="{l:T Menu_NextHit}" InputGestureText="F3" Click="OnNextHitClick"/>
                <MenuItem Header="{l:T Menu_PrevHit}" InputGestureText="Mayús+F3" Click="OnPrevHitClick"/>
                <Separator/>
                <MenuItem Header="{l:T Menu_FindPassage}" InputGestureText="Ctrl+Mayús+P" Click="OnFindPassageClick"/>
                <Separator/>
                <MenuItem Header="{l:T Menu_ToggleBookmark}" InputGestureText="Ctrl+F2" Click="OnToggleBookmarkClick"/>
                <MenuItem Header="{l:T Menu_NextBookmark}" InputGestureText="F2" Click="OnNextBookmarkClick"/>
                <MenuItem Header="{l:T Menu_PrevBookmark}" InputGestureText="Mayús+F2" Click="OnPrevBookmarkClick"/>
            </MenuItem>
            <MenuItem Header="{l:T Menu_Go}">
                <MenuItem Header="{l:T Menu_Palette}" InputGestureText="Ctrl+P" Click="OnPaletteClick"/>
                <MenuItem Header="{l:T Menu_GoTo}" InputGestureText="Ctrl+G" Click="OnGoToClick"/>
                <Separator/>
                <MenuItem Header="{l:T Menu_LastPosition}" Click="OnLastPositionClick"/>
                <MenuItem Header="{l:T Menu_Back}" InputGestureText="Alt+←" Click="OnBackClick"/>
                <MenuItem Header="{l:T Menu_Forward}" InputGestureText="Alt+→" Click="OnForwardClick"/>
                <Separator/>
                <MenuItem Header="{l:T Menu_NextChapter}" InputGestureText="Ctrl+AvPág" Click="OnNextChapterClick"/>
                <MenuItem Header="{l:T Menu_PrevChapter}" InputGestureText="Ctrl+RePág" Click="OnPrevChapterClick"/>
            </MenuItem>
            <MenuItem Header="{l:T Menu_Book}">
                <MenuItem Header="{l:T Menu_AddPage}" Click="OnAddPageClick"/>
                <MenuItem Header="{l:T Menu_ImportPage}" Click="OnImportPageClick"/>
                <MenuItem Header="{l:T Menu_DuplicatePage}" Click="OnDuplicatePageClick"/>
                <MenuItem Header="{l:T Menu_RenamePage}" Click="OnRenamePageClick"/>
                <MenuItem Header="{l:T Menu_DeletePages}" Click="OnDeletePagesClick"/>
                <Separator/>
                <MenuItem Header="{l:T Menu_MoveUp}" InputGestureText="Alt+↑" Click="OnMoveUpClick"/>
                <MenuItem Header="{l:T Menu_MoveDown}" InputGestureText="Alt+↓" Click="OnMoveDownClick"/>
                <MenuItem Header="{l:T Menu_Split}" InputGestureText="Ctrl+Alt+Intro" Click="OnSplitClick"/>
                <MenuItem Header="{l:T Menu_Merge}" Click="OnMergeClick"/>
                <Separator/>
                <MenuItem Header="{l:T Menu_Toc}" InputGestureText="Ctrl+Alt+T" Click="OnTocClick"/>
                <MenuItem Header="{l:T Menu_Metadata}" Click="OnMetadataClick"/>
                <MenuItem Header="{l:T Menu_Original}" InputGestureText="Ctrl+Alt+O" Click="OnOriginalMenuClick"/>
                <MenuItem Header="{l:T Menu_ClearPins}" Click="OnClearPinsClick"/>
                <MenuItem Header="{l:T Menu_Gallery}" Click="OnGalleryClick"/>
                <MenuItem Header="{l:T Menu_AddFile}" Click="OnAddFileClick"/>
                <MenuItem Header="{l:T Menu_Check}" Click="OnCheckClick"/>
                <MenuItem Header="{l:T Menu_ProblemsPanel}" Click="OnProblemsPanelClick"/>
                <MenuItem Header="{l:T Menu_Epubcheck}" Click="OnEpubcheckClick"/>
                <Separator/>
                <MenuItem x:Name="UndoStructureMenu" Header="{l:T Menu_UndoStructure}" InputGestureText="Ctrl+Z en Capítulos" Click="OnUndoStructureClick" IsEnabled="False"/>
                <MenuItem x:Name="RedoStructureMenu" Header="{l:T Menu_RedoStructure}" InputGestureText="Ctrl+Y en Capítulos" Click="OnRedoStructureClick" IsEnabled="False"/>
            </MenuItem>
            <MenuItem Header="{l:T Menu_View}">
                <MenuItem Header="{l:T Menu_ToggleMode}" InputGestureText="Ctrl+E" Click="OnToggleModeClick"/>
                <MenuItem Header="{l:T Menu_ToggleBottom}" InputGestureText="Ctrl+J" Click="OnToggleBottomClick"/>
                <MenuItem Header="{l:T Menu_NotesPanel}" InputGestureText="Ctrl+Mayús+N" Click="OnNotesPanelClick"/>
                <MenuItem Header="{l:T Menu_ProblemsPanel}" InputGestureText="Ctrl+Mayús+M" Click="OnProblemsPanelClick"/>
                <MenuItem Header="{l:T Menu_SymbolsPanel}" Click="OnSymbolsPanelClick"/>
                <Separator/>
                <MenuItem x:Name="ShowLeftMenu" Header="{l:T Menu_ShowLeft}" IsCheckable="True" IsChecked="True" Click="OnPanelsMenuClick" InputGestureText="Ctrl+Alt+B"/>
                <MenuItem x:Name="ShowPreviewMenu" Header="{l:T Menu_ShowPreview}" IsCheckable="True" IsChecked="True" Click="OnPanelsMenuClick" InputGestureText="Ctrl+Alt+P"/>
                <Separator/>
                <MenuItem Header="{l:T Menu_Theme}">
                    <MenuItem x:Name="ThemeLightMenu" Header="{l:T Menu_ThemeLight}" IsCheckable="True" Click="OnThemeMenuClick"/>
                    <MenuItem x:Name="ThemeDarkMenu" Header="{l:T Menu_ThemeDark}" IsCheckable="True" Click="OnThemeMenuClick"/>
                    <MenuItem x:Name="ThemeSystemMenu" Header="{l:T Menu_ThemeSystem}" IsCheckable="True" Click="OnThemeMenuClick"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="{l:T Menu_CloseTab}" InputGestureText="Ctrl+W" Click="OnCloseTabClick"/>
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Bottom" Background="{DynamicResource StatusBg}" Padding="10,3">
            <DockPanel>
                <TextBlock x:Name="StatusMode" DockPanel.Dock="Right" Foreground="#FFD1D5DB" Margin="16,0,0,0"/>
                <TextBlock x:Name="StatusDirty" DockPanel.Dock="Right" Foreground="#FFFBBF24" Margin="16,0,0,0" Text="{l:T Status_Modified}" Visibility="Collapsed"/>
                <TextBlock x:Name="StatusText" Foreground="White" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <Grid x:Name="MainGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="300" MinWidth="0"/>
                <ColumnDefinition x:Name="LeftSplitterColumn" Width="4"/>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition x:Name="RightSplitterColumn" Width="4"/>
                <ColumnDefinition x:Name="RightColumn" Width="460" MinWidth="0"/>
            </Grid.ColumnDefinitions>

            <!-- left: chapter browser / files -->
            <TabControl x:Name="LeftTabs" Grid.Column="0" BorderThickness="0,1,0,0" Background="{DynamicResource PanelBg}" Padding="0">
                <TabItem Header="{l:T Left_Chapters}">
                    <DockPanel>
                        <TextBox x:Name="ChapterFilter" DockPanel.Dock="Top" Margin="6" Padding="4,3"
                                 TextChanged="OnChapterFilterChanged" ToolTip="{l:T Left_FilterTip}"/>
                        <ListBox x:Name="ChapterList" BorderThickness="0" HorizontalContentAlignment="Stretch" SelectionMode="Extended"
                                 ContextMenuOpening="OnChapterContextMenuOpening"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                                 ItemTemplate="{StaticResource ChapterTemplate}" ItemContainerStyle="{DynamicResource ChapterItem}"
                                 SelectionChanged="OnChapterSelectionChanged"
                                 MouseDoubleClick="OnChapterDoubleClick" KeyDown="OnChapterListKeyDown">
                            <ListBox.ContextMenu>
                                <ContextMenu/>
                            </ListBox.ContextMenu>
                        </ListBox>
                    </DockPanel>
                </TabItem>
                <TabItem Header="{l:T Left_Files}">
                    <TreeView x:Name="FileTree" BorderThickness="0" MouseDoubleClick="OnFileTreeDoubleClick" KeyDown="OnFileTreeKeyDown"
                              ContextMenuOpening="OnFileContextMenuOpening" PreviewMouseRightButtonDown="OnFileTreeRightClick">
                        <TreeView.ContextMenu>
                            <ContextMenu/>
                        </TreeView.ContextMenu>
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type vm:FileGroup}" ItemsSource="{Binding Items}">
                                <TextBlock Text="{Binding Header}" FontWeight="SemiBold" Margin="0,2"/>
                            </HierarchicalDataTemplate>
                            <DataTemplate DataType="{x:Type vm:FileItem}">
                                <TextBlock Text="{Binding Name}" ToolTip="{Binding ToolTipText}" Margin="0,1"/>
                            </DataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </TabItem>
                <TabItem x:Name="BookmarksTab" Header="{l:T Left_Bookmarks}">
                    <DockPanel>
                        <TextBlock x:Name="BookmarksEmpty" DockPanel.Dock="Top" Text="{l:T Bookmarks_Empty}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Muted}" Margin="10"/>
                        <ListBox x:Name="BookmarkList" BorderThickness="0" HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 MouseLeftButtonUp="OnBookmarkClick" KeyDown="OnBookmarkKeyDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:BookmarkItem}">
                                    <StackPanel Margin="2,4">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding PositionText}" Foreground="{DynamicResource Muted}" FontSize="11"/>
                                            <TextBlock Text="{Binding Header}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                <Run Text="⚑ " Foreground="{DynamicResource Accent}"/>
                                            </TextBlock>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Snippet}" Foreground="{DynamicResource Muted}" FontStyle="Italic" FontSize="11.5"
                                                   TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{l:T Bookmarks_Delete}" Click="OnDeleteBookmarkClick"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                    </DockPanel>
                </TabItem>
            </TabControl>

            <GridSplitter x:Name="LeftSplitter" Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{DynamicResource Border}"/>

            <!-- center: editor tabs -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="120"/>
                    <RowDefinition x:Name="BottomSplitterRow" Height="0"/>
                    <RowDefinition x:Name="BottomRow" Height="0"/>
                </Grid.RowDefinitions>
                <TabControl x:Name="DocTabs" BorderThickness="0,1,0,0" Padding="0" Background="{DynamicResource PanelBg}"
                            SelectionChanged="OnDocTabChanged" Visibility="Collapsed"/>
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="Assets/kaku_logo.png" Width="300" Margin="0,0,0,24" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock HorizontalAlignment="Center" TextAlignment="Center" Foreground="{DynamicResource Muted}"
                               FontSize="14" LineHeight="24" Text="{l:T Empty_State}"/>
                </StackPanel>
                <GridSplitter x:Name="BottomSplitter" Grid.Row="1" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="{DynamicResource Border}" Visibility="Collapsed"/>
                <Grid x:Name="BottomPanel" Grid.Row="2" Background="{DynamicResource PanelBg}" Visibility="Collapsed">
                    <TabControl x:Name="BottomTabs" BorderThickness="0,1,0,0" Padding="0" Background="{DynamicResource PanelBg}" SelectionChanged="OnBottomTabChanged">
                        <TabItem x:Name="SearchTab" Header="{l:T Bottom_Search}">
                            <views:SearchPanel x:Name="Search"/>
                        </TabItem>
                        <TabItem x:Name="NotesTab" Header="{l:T Bottom_Notes}">
                            <views:NotesPanel x:Name="NotesView"/>
                        </TabItem>
                        <TabItem x:Name="ProblemsTab" Header="{l:T Bottom_Problems}">
                            <views:ProblemsPanel x:Name="Problems"/>
                        </TabItem>
                        <TabItem x:Name="SymbolsTab" Header="{l:T Bottom_Symbols}">
                            <views:SymbolsPanel x:Name="SymbolsView"/>
                        </TabItem>
                    </TabControl>
                    <Button Content="×" Padding="6,0" BorderThickness="0" Background="Transparent" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,2,6,0" ToolTip="{l:T Bottom_CloseTip}" Click="OnCloseBottomClick" Focusable="False"/>
                </Grid>
            </Grid>

            <GridSplitter x:Name="RightSplitter" Grid.Column="3" Width="4" HorizontalAlignment="Stretch" Background="{DynamicResource Border}"/>

            <!-- right: preview -->
            <DockPanel x:Name="RightPanel" Grid.Column="4" Background="{DynamicResource PanelBg}">
                <TabControl x:Name="RightTabs" BorderThickness="0,1,0,0" Padding="0" Background="{DynamicResource PanelBg}" SelectionChanged="OnRightTabChanged">
                    <TabItem x:Name="PreviewTab" Header="{l:T Preview_Title}">
                        <views:PreviewPane x:Name="Preview"/>
                    </TabItem>
                    <TabItem x:Name="OriginalTab" Header="{l:T Original_Tab}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="{DynamicResource SubtleBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="8,4">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button x:Name="PinButton" Content="{l:T Original_Pin}" Padding="6,1" Margin="4,0,0,0" Click="OnPinClick" ToolTip="{l:T Original_PinTip}"/>
                                        <Button Content="{l:T Original_Change}" Padding="6,1" Margin="4,0,0,0" Click="OnChooseOriginalClick"/>
                                    </StackPanel>
                                    <TextBlock x:Name="OriginalInfo" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </Border>
                            <Grid>
                                <views:PreviewPane x:Name="OriginalPreview" ForceHorizontal="True"/>
                                <StackPanel x:Name="OriginalEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20" Background="{DynamicResource PanelBg}">
                                    <TextBlock Text="{l:T Original_Empty}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Muted}" MaxWidth="320"/>
                                    <Button Content="{l:T Original_Choose}" Padding="12,4" Margin="0,12,0,0" HorizontalAlignment="Center" Click="OnChooseOriginalClick"/>
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
