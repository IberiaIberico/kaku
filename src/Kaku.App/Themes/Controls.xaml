<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Styles for long-lived controls. Use them with DynamicResource: on every theme change Theme.Apply
         reloads this file and bases each style on the theme's own style for its TargetType. -->
    <Style x:Key="SearchOption" TargetType="ToggleButton">
        <Setter Property="MinWidth" Value="30"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="Padding" Value="5,0"/>
        <Setter Property="Background" Value="{DynamicResource SubtleBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
        <Setter Property="Focusable" Value="False"/>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource ToggleOnBg}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SmallButton" TargetType="Button">
        <Setter Property="Height" Value="24"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="Margin" Value="3,0"/>
    </Style>

    <Style x:Key="BarButton" TargetType="Button">
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="Margin" Value="0,0,6,4"/>
    </Style>

    <Style x:Key="ChapterItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="4,0"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding ContainsCurrent}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RowContainsCurrent}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RowCurrent}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
