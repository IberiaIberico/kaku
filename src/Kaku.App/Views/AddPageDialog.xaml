<Window x:Class="Kaku.App.Views.AddPageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Kaku.App.Localization"
        Title="{l:T AddPage_Title}" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="14">
        <TextBlock Text="{l:T AddPage_Type}"/>
        <ComboBox x:Name="TypeBox" Margin="0,4,0,10" SelectionChanged="OnTypeChanged">
            <ComboBoxItem Content="{l:T AddPage_Blank}" IsSelected="True"/>
            <ComboBoxItem Content="{l:T AddPage_Note}"/>
            <ComboBoxItem Content="{l:T AddPage_Characters}"/>
        </ComboBox>
        <TextBlock Text="{l:T AddPage_PageTitle}"/>
        <TextBox x:Name="TitleBox" Margin="0,4,0,10" Padding="4,3"/>
        <TextBlock x:Name="ImportedText" Foreground="#FF15803D" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>
        <TextBlock Text="{l:T AddPage_Where}"/>
        <StackPanel Margin="0,4,0,10">
            <RadioButton x:Name="AfterRadio" Content="{l:T AddPage_After}" IsChecked="True" Margin="0,2"/>
            <RadioButton x:Name="BeforeRadio" Content="{l:T AddPage_Before}" Margin="0,2"/>
            <RadioButton x:Name="EndRadio" Content="{l:T AddPage_End}" Margin="0,2"/>
        </StackPanel>
        <CheckBox x:Name="TocCheck" Content="{l:T AddPage_AddToToc}" IsChecked="True"/>
        <DockPanel Margin="0,16,0,0">
            <Button Content="{l:T AddPage_Import}" Padding="10,3" Click="OnImport" ToolTip="{l:T AddPage_ImportTip}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{l:T AddPage_Add}" MinWidth="90" Padding="10,3" IsDefault="True" Click="OnOk"/>
                <Button Content="{l:T Common_Cancel}" MinWidth="90" Padding="10,3" Margin="8,0,0,0" IsCancel="True"/>
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
