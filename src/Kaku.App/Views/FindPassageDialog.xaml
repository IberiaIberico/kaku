<Window x:Class="Kaku.App.Views.FindPassageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Kaku.App.Localization"
        Title="{l:T Passage_Title}" Width="760" Height="520" MinHeight="300" MinWidth="480"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="{l:T Passage_Prompt}" TextWrapping="Wrap" Margin="0,0,0,6"/>
        <TextBox x:Name="Input" DockPanel.Dock="Top" Height="74" AcceptsReturn="True" TextWrapping="Wrap" Padding="5,4"
                 FontFamily="Georgia, Yu Mincho" FontSize="14" VerticalScrollBarVisibility="Auto"
                 TextChanged="OnInputChanged" PreviewKeyDown="OnInputKeyDown"/>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock x:Name="Status" Foreground="#FF6B7280" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="GoButton" Content="{l:T GoTo_Go}" MinWidth="90" Padding="10,3" IsDefault="False" Click="OnGo" IsEnabled="False"/>
                <Button Content="{l:T Common_Cancel}" MinWidth="90" Padding="10,3" Margin="8,0,0,0" IsCancel="True"/>
            </StackPanel>
        </DockPanel>
        <ListBox x:Name="Results" Margin="0,10,0,0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseDoubleClick="OnGo" KeyDown="OnResultsKeyDown" SelectionChanged="OnSelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2,4">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ScoreText}" FontWeight="SemiBold" Foreground="{Binding ScoreBrush}" Margin="8,0,0,0"/>
                            <TextBlock Text="{Binding Header}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <TextBlock TextWrapping="Wrap" FontFamily="Georgia, Yu Mincho" Margin="0,2,0,0">
                            <Run Text="{Binding Before, Mode=OneWay}" Foreground="#FF6B7280"/><Run Text="{Binding MatchText, Mode=OneWay}" Background="#FFFFE38A"/><Run Text="{Binding After, Mode=OneWay}" Foreground="#FF6B7280"/>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
