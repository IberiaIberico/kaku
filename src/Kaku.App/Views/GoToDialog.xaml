<Window x:Class="Kaku.App.Views.GoToDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Kaku.App.Localization"
        Title="{l:T GoTo_Title}" Width="520" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="14">
        <TextBlock Text="{l:T GoTo_Prompt}" Margin="0,0,0,6"/>
        <TextBox x:Name="Input" FontSize="15" Padding="6,4" TextChanged="OnInputChanged" PreviewKeyDown="OnInputKeyDown"/>
        <TextBlock x:Name="Result" Margin="0,8,0,0" FontWeight="SemiBold" TextWrapping="Wrap" MinHeight="20"/>
        <TextBlock Text="{l:T GoTo_Help}" Margin="0,10,0,0" Foreground="Gray" FontSize="11.5" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="GoButton" Content="{l:T GoTo_Go}" MinWidth="90" Padding="10,3" IsDefault="True" Click="OnGo"/>
            <Button Content="{l:T Common_Cancel}" MinWidth="90" Padding="10,3" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
