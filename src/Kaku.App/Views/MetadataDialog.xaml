<Window x:Class="Kaku.App.Views.MetadataDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Kaku.App.Localization"
        Title="{l:T Meta_Title}" Width="720" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBg}" Foreground="{DynamicResource Text}">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Right" Width="200" Margin="16,0,0,0">
            <TextBlock Text="{l:T Meta_Cover}"/>
            <Border BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1" Height="260" Margin="0,4,0,6" Background="{DynamicResource SubtleBg}">
                <Image x:Name="CoverImage" Stretch="Uniform"/>
            </Border>
            <ComboBox x:Name="CoverBox" SelectionChanged="OnCoverChanged" ToolTip="{l:T Meta_CoverTip}"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{l:T Common_Ok}" MinWidth="90" Padding="10,3" IsDefault="True" Click="OnOk"/>
            <Button Content="{l:T Common_Cancel}" MinWidth="90" Padding="10,3" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Margin" Value="0,7,10,0"/>
                    <Setter Property="VerticalAlignment" Value="Top"/>
                </Style>
                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                    <Setter Property="Margin" Value="0,4"/>
                    <Setter Property="Padding" Value="4,3"/>
                </Style>
            </Grid.Resources>
            <TextBlock Text="{l:T Meta_BookTitle}"/>
            <TextBox x:Name="TitleBox" Grid.Column="1"/>
            <TextBlock Grid.Row="1" Text="{l:T Meta_Authors}"/>
            <TextBox x:Name="AuthorsBox" Grid.Row="1" Grid.Column="1" AcceptsReturn="True" Height="54" VerticalScrollBarVisibility="Auto" ToolTip="{l:T Meta_AuthorsTip}"/>
            <TextBlock Grid.Row="2" Text="{l:T Meta_Language}"/>
            <TextBox x:Name="LanguageBox" Grid.Row="2" Grid.Column="1" Width="90" HorizontalAlignment="Left" ToolTip="{l:T Meta_LanguageTip}"/>
            <TextBlock Grid.Row="3" Text="{l:T Meta_Publisher}"/>
            <TextBox x:Name="PublisherBox" Grid.Row="3" Grid.Column="1"/>
            <TextBlock Grid.Row="4" Text="{l:T Meta_Series}"/>
            <DockPanel Grid.Row="4" Grid.Column="1">
                <TextBox x:Name="SeriesIndexBox" DockPanel.Dock="Right" Width="60" Margin="8,4,0,4" ToolTip="{l:T Meta_SeriesIndex}"/>
                <TextBox x:Name="SeriesBox"/>
            </DockPanel>
            <TextBlock Grid.Row="5" Text="{l:T Meta_Description}"/>
            <TextBox x:Name="DescriptionBox" Grid.Row="5" Grid.Column="1" AcceptsReturn="True" TextWrapping="Wrap" Height="120" VerticalScrollBarVisibility="Auto"/>
        </Grid>
    </DockPanel>
</Window>
