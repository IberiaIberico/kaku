<Window x:Class="Kaku.App.Views.NoteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Kaku.App.Localization"
        Title="{l:T Note_Title}" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="14">
        <TextBlock x:Name="WhereText" Foreground="#FF6B7280" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <RadioButton x:Name="NewRadio" Content="{l:T Note_New}" IsChecked="True" Margin="0,0,0,4" Checked="OnModeChanged"/>
        <TextBox x:Name="TextBox" Height="110" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 Padding="5,4" FontFamily="Georgia, Yu Mincho" FontSize="14" Margin="20,0,0,4" PreviewKeyDown="OnTextKeyDown"/>
        <TextBlock Text="{l:T Note_FormatHelp}" Foreground="#FF6B7280" FontSize="11" Margin="20,0,0,10"/>
        <StackPanel x:Name="ReusePanel">
            <RadioButton x:Name="ReuseRadio" Content="{l:T Note_Reuse}" Margin="0,0,0,4" Checked="OnModeChanged"/>
            <ComboBox x:Name="ReuseBox" Margin="20,0,0,0" IsEnabled="False"/>
            <TextBlock x:Name="SuggestText" Foreground="#FF15803D" FontSize="11" Margin="20,3,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="OkButton" Content="{l:T Common_Ok}" MinWidth="90" Padding="10,3" Click="OnOk"/>
            <Button Content="{l:T Common_Cancel}" MinWidth="90" Padding="10,3" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
