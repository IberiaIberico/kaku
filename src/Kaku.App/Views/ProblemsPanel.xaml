<UserControl x:Class="Kaku.App.Views.ProblemsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Kaku.App.Localization"
             Background="White">
    <DockPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="6,5,6,2">
            <ComboBox x:Name="ScopeBox" Height="24" Margin="0,0,6,4" SelectionChanged="OnScopeChanged">
                <ComboBoxItem Content="{l:T Problems_ScopeChapter}"/>
                <ComboBoxItem Content="{l:T Problems_ScopeBook}" IsSelected="True"/>
            </ComboBox>
            <ComboBox x:Name="KindBox" Height="24" MinWidth="210" Margin="0,0,6,4" SelectionChanged="OnKindChanged"/>
            <CheckBox x:Name="SpellingCheck" Content="{l:T Problems_Spelling}" VerticalAlignment="Center" Margin="4,0,10,4" IsChecked="True" Click="OnSpellingClick"/>
            <Button Content="{l:T Problems_Refresh}" Padding="8,2" Margin="0,0,4,4" Click="OnRefresh"/>
            <Button x:Name="FixButton" Content="{l:T Problems_Fix}" Padding="8,2" Margin="0,0,4,4" Click="OnFix" ToolTip="{l:T Problems_FixTip}"/>
            <Button x:Name="FixAllButton" Padding="8,2" Margin="0,0,10,4" Click="OnFixAll"/>
            <Button Content="{l:T Problems_Epubcheck}" Padding="8,2" Margin="0,0,4,4" Click="OnEpubcheck" ToolTip="{l:T Problems_EpubcheckTip}"/>
        </WrapPanel>
        <TextBlock x:Name="SummaryText" DockPanel.Dock="Top" Margin="8,0,8,4" Foreground="#FF6B7280"/>
        <ListView x:Name="List" BorderThickness="0,1,0,0" BorderBrush="#FFE5E7EB" SelectionMode="Extended"
                  MouseDoubleClick="OnDoubleClick" KeyDown="OnListKeyDown" SelectionChanged="OnSelectionChanged"
                  ContextMenuOpening="OnContextMenuOpening">
            <ListView.ContextMenu>
                <ContextMenu/>
            </ListView.ContextMenu>
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="26">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Icon}" Foreground="{Binding IconBrush}" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="{l:T Problems_ColKind}" DisplayMemberBinding="{Binding KindText}" Width="190"/>
                    <GridViewColumn Header="{l:T Problems_ColWhere}" DisplayMemberBinding="{Binding WhereText}" Width="180"/>
                    <GridViewColumn Header="{l:T Problems_ColText}" Width="560">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock ToolTip="{Binding Message}" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Before, Mode=OneWay}" Foreground="#FF4B5563"/><Run Text="{Binding Hit, Mode=OneWay}" Background="#FFFECACA" FontWeight="SemiBold"/><Run Text="{Binding After, Mode=OneWay}" Foreground="#FF4B5563"/>
                                    <Run Text="{Binding FixText, Mode=OneWay}" Foreground="#FF15803D"/>
                                </TextBlock>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
