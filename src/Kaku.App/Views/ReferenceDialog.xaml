<Window x:Class="Kaku.App.Views.ReferenceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Kaku.App.Localization"
        Title="{l:T Original_DialogTitle}" Width="720" Height="440" MinWidth="480" MinHeight="300"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="{l:T Original_DialogHelp}" TextWrapping="Wrap" Foreground="#FF6B7280" Margin="0,0,0,8"/>
        <TextBlock x:Name="CurrentText" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8" FontWeight="SemiBold"/>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="{l:T Original_Browse}" Padding="10,3" Click="OnBrowse"/>
                <Button x:Name="RemoveButton" Content="{l:T Original_Remove}" Padding="10,3" Margin="8,0,0,0" Click="OnRemove"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OkButton" Content="{l:T Original_Use}" MinWidth="90" Padding="10,3" IsDefault="True" Click="OnOk" IsEnabled="False"/>
                <Button Content="{l:T Common_Cancel}" MinWidth="90" Padding="10,3" Margin="8,0,0,0" IsCancel="True"/>
            </StackPanel>
        </DockPanel>
        <TextBlock x:Name="SearchingText" DockPanel.Dock="Top" Text="{l:T Original_Searching}" Foreground="#FF6B7280" Margin="0,0,0,4"/>
        <ListBox x:Name="List" HorizontalContentAlignment="Stretch" MouseDoubleClick="OnOk" SelectionChanged="OnSelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="2,3">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding MatchText}" Foreground="{Binding MatchBrush}" FontWeight="SemiBold" Margin="10,0,0,0"/>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding File}" Foreground="#FF6B7280" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
