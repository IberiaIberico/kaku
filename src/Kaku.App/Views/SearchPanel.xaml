<UserControl x:Class="Kaku.App.Views.SearchPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Kaku.App.Localization"
             xmlns:vm="clr-namespace:Kaku.App.ViewModels"
             Background="{DynamicResource PanelBg}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <CollectionViewSource x:Key="Grouped" x:Name="GroupedSource">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="GroupName"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>

    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="6,5,6,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="160"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="4"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="{l:T Search_Find}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="FindBox" Grid.Column="1" Height="24" Padding="3,2" VerticalContentAlignment="Center"
                     TextChanged="OnQueryChanged" PreviewKeyDown="OnFindKeyDown"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="4,0,0,0">
                <ToggleButton x:Name="CaseOption" Style="{DynamicResource SearchOption}" Content="Aa" ToolTip="{l:T Search_MatchCase}" Click="OnOptionChanged"/>
                <ToggleButton x:Name="WordOption" Style="{DynamicResource SearchOption}" Content="|ab|" ToolTip="{l:T Search_WholeWord}" Click="OnOptionChanged"/>
                <ToggleButton x:Name="AccentOption" Style="{DynamicResource SearchOption}" Content="á=a" ToolTip="{l:T Search_IgnoreAccents}" Click="OnOptionChanged"/>
                <ToggleButton x:Name="RegexOption" Style="{DynamicResource SearchOption}" Content=".*" ToolTip="{l:T Search_Regex}" Click="OnOptionChanged"/>
                <ComboBox x:Name="WhereBox" Margin="6,0,2,0" Height="24" SelectionChanged="OnOptionChanged" ToolTip="{l:T Search_WhereTip}">
                    <ComboBoxItem Content="{l:T Search_InChapter}"/>
                    <ComboBoxItem Content="{l:T Search_InBook}" IsSelected="True"/>
                </ComboBox>
                <ComboBox x:Name="ScopeBox" Margin="2,0" Height="24" SelectionChanged="OnOptionChanged" ToolTip="{l:T Search_ScopeTip}">
                    <ComboBoxItem Content="{l:T Search_ScopeText}" IsSelected="True"/>
                    <ComboBoxItem Content="{l:T Search_ScopeCode}"/>
                </ComboBox>
                <Button x:Name="SavedButton" Style="{DynamicResource SmallButton}" Content="{l:T Search_Saved}" ToolTip="{l:T Search_SavedTip}" Click="OnSavedClick"/>
            </StackPanel>
            <DockPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,5,0,0">
                <CheckBox x:Name="AllCheck" DockPanel.Dock="Right" Content="{l:T Search_CheckAll}" VerticalAlignment="Center" IsChecked="True" Click="OnAllCheckClick"/>
                <TextBlock x:Name="CountText" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>

            <TextBlock Grid.Row="2" Text="{l:T Search_Replace}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="ReplaceBox" Grid.Row="2" Grid.Column="1" Height="24" Padding="3,2" VerticalContentAlignment="Center"
                     TextChanged="OnReplaceChanged" PreviewKeyDown="OnReplaceKeyDown"/>
            <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Margin="4,0,0,0">
                <Button x:Name="ReplaceOneButton" Style="{DynamicResource SmallButton}" Content="{l:T Search_ReplaceOne}" Click="OnReplaceOneClick" ToolTip="{l:T Search_ReplaceOneTip}"/>
                <Button x:Name="ReplaceAllButton" Style="{DynamicResource SmallButton}" Content="{l:T Search_ReplaceAll}" Click="OnReplaceAllClick"/>
                <Button x:Name="UndoReplaceButton" Style="{DynamicResource SmallButton}" Content="{l:T Search_UndoReplace}" Click="OnUndoReplaceClick" IsEnabled="False"/>
            </StackPanel>
        </Grid>

        <ListBox x:Name="Results" ItemsSource="{Binding Source={StaticResource Grouped}}" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderSoft}"
                 HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.ScrollUnit="Pixel"
                 SelectionChanged="OnResultSelected" MouseDoubleClick="OnResultDoubleClick" KeyDown="OnResultsKeyDown">
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock FontWeight="SemiBold" Margin="4,6,0,2" Foreground="{DynamicResource TextStrong}">
                                <Run Text="{Binding Name, Mode=OneWay}"/>
                                <Run Text="{Binding ItemCount, Mode=OneWay, StringFormat=' ({0})'}" Foreground="{DynamicResource Muted}"/>
                            </TextBlock>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:SearchHitItem}">
                    <DockPanel Margin="14,1,4,1">
                        <CheckBox IsChecked="{Binding Include}" VerticalAlignment="Center" Margin="0,0,6,0" Focusable="False"
                                  Visibility="{Binding HasReplacement, Converter={StaticResource BoolVis}}"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding PositionText}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock TextTrimming="CharacterEllipsis" FontFamily="Georgia, Yu Mincho">
                            <Run Text="{Binding Before, Mode=OneWay}" Foreground="{DynamicResource TextSofter}"/><Run Text="{Binding Match, Mode=OneWay}" Background="{DynamicResource MatchBg}" FontWeight="SemiBold"
                                 TextDecorations="{Binding HasReplacement, Converter={x:Static vm:SearchHitItemConverters.Strike}}"/><Run Text="{Binding Replacement, Mode=OneWay}" Background="{DynamicResource ReplaceBg}" FontWeight="SemiBold"/><Run Text="{Binding After, Mode=OneWay}" Foreground="{DynamicResource TextSofter}"/>
                        </TextBlock>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
