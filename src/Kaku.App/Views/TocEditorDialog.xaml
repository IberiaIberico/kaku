<Window x:Class="Kaku.App.Views.TocEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Kaku.App.Localization"
        xmlns:views="clr-namespace:Kaku.App.Views"
        Title="{l:T Toc_Title}" Width="760" Height="600" MinWidth="520" MinHeight="360"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="{l:T Toc_Help}" TextWrapping="Wrap" Foreground="#FF6B7280" Margin="0,0,0,8"/>
        <StackPanel DockPanel.Dock="Right" Margin="10,0,0,0" Width="190">
            <Button Content="{l:T Toc_Up}" Click="OnUp" Margin="0,0,0,4" Padding="6,3"/>
            <Button Content="{l:T Toc_Down}" Click="OnDown" Margin="0,0,0,4" Padding="6,3"/>
            <Button Content="{l:T Toc_Outdent}" Click="OnOutdent" Margin="0,0,0,4" Padding="6,3"/>
            <Button Content="{l:T Toc_Indent}" Click="OnIndent" Margin="0,0,0,12" Padding="6,3"/>
            <Button x:Name="AddCurrentButton" Content="{l:T Toc_AddCurrent}" Click="OnAddCurrent" Margin="0,0,0,4" Padding="6,3"/>
            <Button Content="{l:T Toc_Delete}" Click="OnDelete" Margin="0,0,0,12" Padding="6,3"/>
            <Button Content="{l:T Toc_Generate}" Click="OnGenerate" Margin="0,0,0,4" Padding="6,3" ToolTip="{l:T Toc_GenerateTip}"/>
            <Button Content="{l:T Toc_Sort}" Click="OnSort" Margin="0,0,0,4" Padding="6,3"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{l:T Common_Ok}" MinWidth="90" Padding="10,3" IsDefault="True" Click="OnOk"/>
            <Button Content="{l:T Common_Cancel}" MinWidth="90" Padding="10,3" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
        <ListBox x:Name="Rows" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyDown="OnRowsKeyDown">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type views:TocRow}">
                    <DockPanel Margin="{Binding Indent}">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding TargetText}" Foreground="#FF6B7280" FontSize="11" Margin="8,0,0,0"
                                   VerticalAlignment="Center" MaxWidth="240" TextTrimming="CharacterEllipsis" ToolTip="{Binding TargetText}"/>
                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0,0,0,1" Padding="2,1" Background="Transparent"/>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
